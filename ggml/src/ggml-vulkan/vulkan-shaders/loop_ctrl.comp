#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable

// Fused Inkling 2 loop controller tail: d = (x - tanh(f)*x) + tanh(g)*m, all contiguous and the same shape.
// With rms_partials it also stores the sums of squares for a following RMS_NORM, as add.comp does for the ADD
const uint num_threads = 256;

layout(local_size_x = num_threads, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly  buffer F {float data_f[];};
layout (binding = 1) readonly  buffer G {float data_g[];};
layout (binding = 2) readonly  buffer X {float data_x[];};
layout (binding = 3) readonly  buffer M {float data_m[];};
layout (binding = 4) writeonly buffer D {float data_d[];};
layout (binding = 5, std430)   buffer PartialBuf {float partial_sums[];};

layout (push_constant) uniform parameter {
    uint ne;
    uint f_offset, g_offset, x_offset, m_offset, d_offset;
    uint rms_partials;
    uint row_len; // nonzero: the z workgroup is the row, and each row writes partial sums as a row of its own
} p;

shared float sumsh[num_threads];

// as in unary.comp, so the result matches the unfused ops
float op_tanh(float x) {
    return 1.0f - 2.0f / (exp(2.0f*x) + 1.0f);
}

void main() {
    uint idx = gl_GlobalInvocationID.z * 262144 + gl_GlobalInvocationID.y * 512 + gl_GlobalInvocationID.x;
    uint end = p.ne;
    uint partial = idx / 512;
    if (p.row_len != 0) {
        const uint col = gl_GlobalInvocationID.y * 512 + gl_GlobalInvocationID.x;
        idx     = gl_WorkGroupID.z * p.row_len + col;
        end     = (gl_WorkGroupID.z + 1) * p.row_len;
        partial = gl_WorkGroupID.z * ((p.row_len + 511) / 512) + col / 512;
    }

    // laid out as add.comp, so the partial sums add in the same order
    const uint num_iter = 2;

    float sum_sq = 0;

    [[unroll]] for (uint i = 0; i < num_iter; ++i) {
        if (idx >= end) {
            continue;
        }

        const float x = data_x[p.x_offset + idx];
        const float forget = op_tanh(data_f[p.f_offset + idx]) * x;
        const float gain   = op_tanh(data_g[p.g_offset + idx]) * data_m[p.m_offset + idx];
        // precise reaches back through forget and gain and keeps each step rounded on its own, as the
        // separate MUL, SUB and ADD ops store it. Without it about a fifth of the results differ
        precise float d = (x - forget) + gain;
        sum_sq += d*d;

        data_d[p.d_offset + idx] = d;

        idx += num_threads;
    }

    if (p.rms_partials != 0) {
        const uint NumSubgroups = num_threads / gl_SubgroupSize;
        sum_sq = subgroupAdd(sum_sq);
        if (gl_SubgroupInvocationID == 0) {
            sumsh[gl_SubgroupID] = sum_sq;
        }
        barrier();
        [[unroll]] for (uint s = NumSubgroups / 2; s > 0; s >>= 1) {
            if (gl_SubgroupID < s && gl_SubgroupInvocationID == 0) {
                sum_sq += sumsh[gl_SubgroupID + s];
                sumsh[gl_SubgroupID] = sum_sq;
            }
            barrier();
        }

        if (gl_SubgroupID == 0 && gl_SubgroupInvocationID == 0) {
            partial_sums[partial] = sum_sq;
        }
    }
}
